<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Inutile au fonctionnement (tout est embarqué), mais évite toute
         surprise si une évolution future charge une ressource en ligne. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Déverrouillage par empreinte. L'application ne lit jamais l'empreinte :
         elle demande au système de vérifier et n'obtient qu'un oui ou un non. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:label="DC EVENT COMMANDE"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/ThemeDC">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
